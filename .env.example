# ============================================================
# Zane Invest WORKBENCH 环境变量配置
# 复制本文件为 .env 并按需填写；切勿把真实 key 提交到 git
# ============================================================

# —— AI（必填，否则 AI 功能降级为本地规则引擎）——
# DeepSeek API key（充值后即可用；请使用你自己的专用 key，不要分享）
DEEPSEEK_API_KEY=

# 可选：自建/代理的 OpenAI 兼容端点（默认 https://api.deepseek.com）
DEEPSEEK_BASE_URL=

# 可选：模型名（默认 deepseek-chat）
DEEPSEEK_MODEL=

# —— 访问门禁（公网部署强烈建议开启）——
# 后端门禁：设置后，所有 /api 请求必须携带 Authorization: Bearer <token>
ACCESS_TOKEN=
# 前端构建期注入的访问令牌（与 ACCESS_TOKEN 一致；也可运行时在 localStorage 写 zane_access_token）
VITE_ACCESS_TOKEN=

# —— 行情开关 ——
# 是否启用腾讯实时行情与K线（默认启用；设为 false 时使用内置样例数据）
ENABLE_REALTIME_QUOTES=true

# —— 可选：Tushare Pro 财报（配置后优先使用 Tushare；未配置时 A 股自动用东财公开接口，无需 token）——
TUSHARE_TOKEN=
TUSHARE_API_URL=

# —— 服务 ——
# 监听端口（默认 3000；本机常被占用，建议 3999）
PORT=3999
# 生产模式运行：npm run build 后用 NODE_ENV=production npm start
# NODE_ENV=production